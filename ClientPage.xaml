<Page x:Class="Vakhitova_LanguageSchool.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vakhitova_LanguageSchool"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>

        <ListView Name="ClientsListView" Grid.Row="1" SelectionChanged="ClientsListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="550"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Grid.Column="0" Grid.RowSpan="8" Width="200" Stretch="UniformToFill" HorizontalAlignment="Left">
                            <Image.Source>
                                <Binding Path="PhotoPath">
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding ID}" FontSize="20"></TextBlock>

                            <TextBlock Text=" " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding LastName}" FontSize="20"></TextBlock>

                            <TextBlock Text=" " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding FirstName}" FontSize="20"></TextBlock>

                            <TextBlock Text=" " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding Patronymic}" FontSize="20"></TextBlock>
                        </StackPanel>

                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Пол: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding GenderFull}" FontSize="20"></TextBlock>
                        </StackPanel>

                        
                        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding Phone}" FontSize="20"></TextBlock>
                            
                            <TextBlock Text=" | " FontSize="20"></TextBlock>
                            
                            <TextBlock Text="{Binding Email}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="Дата рождения: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding BirthdayString}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="Дата добавления: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding RegistrationDateString}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal">
                            <TextBlock Text="Дата последнего посещения: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding LastVisitDate}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="6" Orientation="Horizontal">
                            <TextBlock Text="Количество посещений: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding VisitsCount}" FontSize="20"></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Content="Удалить" Name="DeleteBtn" Grid.Row="2"  HorizontalAlignment="Left" VerticalAlignment="Center"
             Click="DeleteBtn_Click" Width="100" Visibility="Hidden"></Button>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Name="TBCount" FontSize="20"></TextBlock>

            <TextBlock Name="TBAllRecords" FontSize="20"></TextBlock>

            <TextBlock Text="      Выводить по " FontSize="20"></TextBlock>

            <ComboBox Name="PageListCB" Height="30" Width="70" SelectionChanged="PageListCB_SelectionChanged">
                <TextBlock>10</TextBlock>
                <TextBlock>50</TextBlock>
                <TextBlock>200</TextBlock>
                <TextBlock>Все</TextBlock>
            </ComboBox>
            
            <Button Name="LeftDirButton" Content="&lt;" Width="30" Height="30"
                    Click="LeftDirButton_Click"></Button>

            <ListBox FontSize="20" Name="PageListBox" MouseUp="PageListBox_MouseUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Button Name="RightDirButton" Content="&gt;" Width="30" Height="30"
                    Click="RightDirButton_Click"></Button>
        </StackPanel>
        
     </Grid>
</Page>
