<Page x:Class="Vakhitova_LanguageSchool.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vakhitova_LanguageSchool"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientPage" FontFamily="Comic Sans MS">

    <Grid>

        <ListView Name="ClientsListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Grid.Column="0" Grid.RowSpan="8" Width="200" Stretch="UniformToFill" HorizontalAlignment="Left">
                            <Image.Source>
                                <Binding Path="PhotoPath">
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding ID}" FontSize="20"></TextBlock>

                            <TextBlock Text=" " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding LastName}" FontSize="20"></TextBlock>

                            <TextBlock Text=" " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding FirstName}" FontSize="20"></TextBlock>

                            <TextBlock Text=" " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding Patronymic}" FontSize="20"></TextBlock>
                        </StackPanel>

                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Пол: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding GenderFull}" FontSize="20"></TextBlock>
                        </StackPanel>

                        
                        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding Phone}" FontSize="20"></TextBlock>
                            
                            <TextBlock Text=" | " FontSize="20"></TextBlock>
                            
                            <TextBlock Text="{Binding Email}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="Дата рождения: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding BirthdayString}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="Дата добавления: " FontSize="20"></TextBlock>

                            <TextBlock Text="{Binding RegistrationDateString}" FontSize="20"></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal">
                            <TextBlock Text="Дата последнего посещения: " FontSize="20"></TextBlock>
                            
                        </StackPanel>


                        <StackPanel Grid.Column="1" Grid.Row="6" Orientation="Horizontal">
                            <TextBlock Text="Количество посещений: " FontSize="20"></TextBlock>
                            
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
     </Grid>
</Page>
